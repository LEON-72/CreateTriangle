*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build Results & Intermediate directories
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Build artifacts & symbols
*.obj
*.ilk
*.pdb
*.tlog
*.idb
*.lastbuildstate
*.unsuccessfulbuild
*.manifest
*.res
*.pch
*.exp
*.lib
*.exe
*.dll

# Visual Studio files
.vs/
*.VC.db
*.VC.opendb
UpgradeLog*.XML
UpgradeLog*.htm

# JetBrains / CLion / Rider
.idea/
cmake-build-*/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Windows temporary files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
